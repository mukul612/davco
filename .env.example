# Copy this file to ".env" and adjust as needed. start-server.ps1 loads it
# automatically. Never commit the real ".env" file (it's in .gitignore).

# --- Network ---
APP_HOST=127.0.0.1
APP_PORT=8000

# --- Job storage / cleanup ---
JOB_RETENTION_HOURS=24
CLEANUP_INTERVAL_MINUTES=30

# --- Upload limits ---
MAX_UPLOAD_MB=50

# --- Claude ---
# Leave blank to use the `claude` CLI's own existing login on this machine
# (recommended -- nothing to manage). Set this only if you want the
# interpretation step to authenticate with a dedicated API key instead.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_TIMEOUT_SECONDS=180

# --- Optional shared password ---
# Leave blank to disable authentication entirely (fine for a trusted
# internal LAN). Set a value to require it before the app is usable.
APP_PASSWORD=

# --- Misc ---
DEBUG=false
